<layout>
    <composite x="7" y="7" name="date_and_time">
        <component type="datetime" x="0" y="0" format="%H:%M:%S" size="43" align="left"/>
        <component type="datetime" x="0" y="53" format="%Y/%m/%d" size="21" align="left"/>
    </composite>

    <component type="journey_map" name="journey_map" x="2107" y="33" size="427" corner_radius="23"/>

    <composite x="2267" name="gps_info">
        <frame name="gps-lock" x="200" width="21" height="21" bg="0,0,0,128" cr="5" opacity="0.4">
            <component type="gps-lock-icon" size="21"/>
         </frame>

            <component type="metric" metric="lat" dp="6" size="21" align="right" cache="False"/>
            <component type="metric" x="171" metric="lon" dp="6" size="21" align="right" cache="False"/>
    </composite>

    <composite x="21" y="1133" name="speed">
        <component type="metric_unit" metric="speed" units="kph" size="21">{:~c}</component>
        <component type="metric" x="0" y="0" metric="speed" units="kph" dp="0" size="200" />
    </composite>

    <composite x="21" y="1320" name="altitude">
        <component type="metric_unit" x="100" y="0" metric="alt" units="alt" size="21">ALT({:~C})</component>
        <component type="icon" x="0" y="0" file="mountain.png" size="85"/>
        <component type="metric" x="100" y="21" metric="alt" units="alt" dp="0" size="43" />
    </composite>

    <composite x="120" y="1320" name="gradient">
        <component type="text" x="100" y="0" size="21">SLOPE(%)</component>
        <component type="metric" x="100" y="21" metric="gradient" dp="0" size="43" />
    </composite>

    <component type="chart" name="gradient_chart" x="533" y="1320" height="100" textsize="21" samples="1500"/>

    <composite x="2467" y="1200" name="heartbeat">
        <component type="text" x="-53" y="0" size="21" align="right">BPM</component>
        <component type="icon" x="-43" y="0" file="heartbeat.png" size="85"/>
        <component type="metric" x="-53" y="12" metric="hr" dp="0" size="43" align="right"/>
    </composite>

    <composite x="2467" y="1320" name="cadence">
        <component type="text" x="-53" y="0" size="21" align="right">RPM</component>
        <component type="icon" x="-43" y="0" file="gauge.png" size="85"/>
        <component type="metric" x="-53" y="12" metric="cadence" dp="0" size="43" align="right"/>
    </composite>

    <composite x="2200" y="1320" name="odometer">
        <component type="metric" x="0" y="0" metric="odo" units="km" dp="1" size="43" align="right"/>
        <component type="metric_unit" x="7" y="0" metric="odo" units="km" size="43">{:~C}</component>
    </composite>

</layout>
